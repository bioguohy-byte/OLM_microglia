MG_PROJECT_ROOT=/path/to/existing/project
MG_LPC_ROOT=/path/to/LPC/project
MG_WORKSPACE_ROOT=/path/to/approved/workspace
MG_CONDA_ACTIVATE=/path/to/conda/bin/activate
# MG_OUTPUT_ROOT is optional; default is this code repository outputs directory.
